{
  "name": "kimi-code-switch",
  "version": "2.2.7",
  "description": "Local web configuration companion for Kimi Code.",
  "author": "fx1226",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/build-icons.mjs && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node scripts/build-server.mjs && node dist-server/server.mjs --no-open",
    "build:web": "node scripts/build-icons.mjs && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:server:sidecar": "node scripts/build-server-sidecar.mjs",
    "build": "npm run build:web && npm run build:server && npm run build:server:sidecar",
    "build:icons": "node scripts/build-icons.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "vitest run src/renderer/src/web",
    "typecheck": "tsc -b",
    "check:performance": "node scripts/check-performance.mjs"
  },
  "pkg": {
    "assets": [
      "dist/**"
    ],
    "targets": [
      "node22-darwin-arm64"
    ]
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.2",
    "@yao-pkg/pkg": "^6.22.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2",
    "esbuild": "^0.25.12"
  },
  "contributors": [
    "Hulk Sun <sunhao.java@gmail.com>"
  ],
  "bin": {
    "kimi-code-switch": "dist-server/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fx1226/kimi-code-switch.git"
  },
  "homepage": "https://github.com/fx1226/kimi-code-switch",
  "bugs": {
    "url": "https://github.com/fx1226/kimi-code-switch/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
